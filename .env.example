# ---- Backend (apps/backend) ----
NODE_ENV=development
PORT=8080
# Public base URL the frontend uses to reach this API (used to derive WS URL)
PUBLIC_API_BASE_URL=http://localhost:8080

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://chat:chat@localhost:5432/chat

# Redis (presence/typing/pubsub — TTLs are load-bearing, spec §10.1)
REDIS_URL=redis://localhost:6379

# Auth — HS256 JWT. FE sends X-User-Token; BE also accepts Authorization: Bearer (spec Q1).
JWT_SECRET=dev-only-change-me-in-prod
ACCESS_TOKEN_TTL_SECONDS=43200
REFRESH_TOKEN_TTL_SECONDS=604800

# Media object store (dev = local dir; S3-swappable later)
MEDIA_STORAGE_DIR=./.storage
# Single hard ceiling for any upload (matches @chat/contract MAX_UPLOAD_BYTES). Default 100 MB.
MAX_UPLOAD_BYTES=104857600

# Rate limits (spec Q5) — per user
RL_SEND_PER_SEC=10
RL_UPLOAD_PER_MIN=5
RL_CALL_CREATE_PER_MIN=3

# WebRTC ICE (spec §11.2 / Q7). Comma-separated STUN/TURN urls.
# TURN creds issued short-lived via HMAC when CALLS_TURN_SECRET is set.
# NOTE: STUN alone cannot traverse most real-world NAT/firewalls — calls between
# users on different networks NEED a TURN relay. Configure a hosted provider below.
CALLS_ICE_URLS=stun:stun.l.google.com:19302
CALLS_TURN_SECRET=

# Hosted TURN provider (recommended). If set, /v1/calls/ice-servers returns
# provider-issued relay credentials. Metered takes precedence over Twilio.
# Metered (free tier): create an app at https://dashboard.metered.ca → TURN.
CALLS_METERED_DOMAIN=          # e.g. yourapp.metered.live
CALLS_METERED_API_KEY=
# Twilio Network Traversal Service (alternative):
CALLS_TWILIO_ACCOUNT_SID=
CALLS_TWILIO_AUTH_TOKEN=

# ---- Frontend (apps/frontend) ----
# Vite reads VITE_-prefixed vars.
VITE_API_BASE_URL=http://localhost:8080
